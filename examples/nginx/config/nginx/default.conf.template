# Game clients open WebSockets on this same domain, so the upgrade has to be
# forwarded. The map keeps "Connection: upgrade" off ordinary requests.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    server_name         ${FRONTEND_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/talo/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/talo/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/talo/chain.pem;
    ssl_dhparam /etc/letsencrypt/dhparams/dhparam.pem;

    location / {
        proxy_set_header    X-Real-IP           $remote_addr;
        # The peer's IP, not $proxy_add_x_forwarded_for — the backend rate limits
        # by it. Behind a CDN, use set_real_ip_from so $remote_addr is the client.
        proxy_set_header    X-Forwarded-For     $remote_addr;
        proxy_set_header    X-Forwarded-Proto   $scheme;
        proxy_set_header    Host                $host;
        proxy_set_header    X-Forwarded-Host    $host;
        proxy_set_header    X-Forwarded-Port    $server_port;
        proxy_pass          http://frontend;
    }
}

server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    server_name         ${BACKEND_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/talo/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/talo/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/talo/chain.pem;
    ssl_dhparam /etc/letsencrypt/dhparams/dhparam.pem;

    location / {
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $remote_addr;
        proxy_set_header    X-Forwarded-Proto   $scheme;
        proxy_set_header    Host                $host;
        proxy_set_header    X-Forwarded-Host    $host;
        proxy_set_header    X-Forwarded-Port    $server_port;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade             $http_upgrade;
        proxy_set_header    Connection          $connection_upgrade;
        # The server pings every 30s; this is well above that.
        proxy_read_timeout  3600s;
        proxy_pass          http://backend;
    }
}
